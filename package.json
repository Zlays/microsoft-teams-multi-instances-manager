{
  "name": "microsoft-teams-instances-manager",
  "productName": "microsoft-teams-instances-manager",
  "version": "1.0.3",
  "description": "",
  "type": "commonjs",
  "scripts": {
    "build": "concurrently \"yarn build:main\" \"yarn build:renderer\"",
    "build:main": "cross-env NODE_OPTIONS=--openssl-legacy-provider NODE_ENV=production webpack --config ./.erb/configs/webpack.config.main.prod.babel.js",
    "build:renderer": "next build",
    "rebuild": "electron-rebuild --parallel --types prod,dev,optional --module-dir src",
    "lint": "eslint . --cache",
    "package": "rimraf dist && yarn build && electron-builder build --publish never",
    "package:win": "yarn build && electron-builder build --publish never",
    "postinstall": "electron-builder install-app-deps",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation concurrently -k \"cross-env BROWSER=none next dev\" \"npm run start:main\"",
    "start": "cross-env NODE_OPTIONS=--no-deprecation concurrently -k \"cross-env BROWSER=none next dev\" \"npm run start:main\"",
    "start:main": "cross-env NODE_ENV=development electron ./.erb/scripts/run-dev.js",
    "start:renderer": "next dev",
    "test": "jest",
    "publish": "yarn build && electron-builder build --publish always"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --cache"
    ],
    "{*.json,.{babelrc,eslintrc,prettierrc}}": [
      "prettier --ignore-path .prettierignore --parser json --write"
    ],
    "*.{css,scss}": [
      "prettier --ignore-path .prettierignore --single-quote --write"
    ],
    "*.{html,md,yml}": [
      "prettier --ignore-path .prettierignore --single-quote --write"
    ]
  },
  "build": {
    "productName": "microsoft-teams-instances-manager",
    "appId": "it.zlays.microsoftTeamsInstancesManager",
    "files": [
      "dist/",
      "node_modules/",
      "index.html",
      "main.prod.js",
      "main.prod.js.map",
      "preload.js",
      "package.json"
    ],
    "afterSign": ".erb/scripts/Notarize.js",
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "directories": {
      "app": "src",
      "buildResources": "assets",
      "output": "release"
    },
    "extraResources": [
      "./assets/**"
    ],
    "publish": {
      "provider": "github",
      "owner": "ZlaysWorkshop",
      "repo": "microsoft-teams-instances-manager"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZlaysWorkshop/microsoft-teams-instances-manager.git"
  },
  "author": {
    "name": "microsoft-teams-instances-manager Maintainers",
    "email": "mirko.buccella.lavoro@gmail.com",
    "url": "https://github.com/ZlaysWorkshop/microsoft-teams-instances-manager"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ZlaysWorkshop/microsoft-teams-instances-manager/issues"
  },
  "keywords": [
    "electron",
    "boilerplate",
    "react",
    "typescript",
    "ts",
    "sass",
    "webpack",
    "hot",
    "reload"
  ],
  "homepage": "https://github.com/ZlaysWorkshop/microsoft-teams-instances-manager#readme",
  "jest": {
    "roots": [
      "<rootDir>/src"
    ],
    "transform": {
      "^.+\\.(js|jsx|ts|tsx)$": [
        "babel-jest",
        {
          "configFile": "./.erb/configs/babel.config.js"
        }
      ]
    },
    "testURL": "http://localhost/",
    "moduleNameMapper": {
      "\\.(jpg|jpeg|png|gif|eot|otf|webp|svg|ttf|woff|woff2|mp4|webm|wav|mp3|m4a|aac|oga)$": "<rootDir>/.erb/mocks/fileMock.js",
      "\\.(css|less|sass|scss)$": "identity-obj-proxy"
    },
    "moduleFileExtensions": [
      "js",
      "jsx",
      "ts",
      "tsx",
      "json"
    ],
    "moduleDirectories": [
      "node_modules",
      "src/node_modules"
    ],
    "setupFiles": []
  },
  "devDependencies": {
    "@babel/core": "^7.12.9",
    "@babel/plugin-proposal-class-properties": "^7.12.1",
    "@babel/plugin-proposal-decorators": "^7.12.1",
    "@babel/plugin-proposal-do-expressions": "^7.12.1",
    "@babel/plugin-proposal-export-default-from": "^7.12.1",
    "@babel/plugin-proposal-export-namespace-from": "^7.12.1",
    "@babel/plugin-proposal-function-bind": "^7.12.1",
    "@babel/plugin-proposal-function-sent": "^7.12.1",
    "@babel/plugin-proposal-json-strings": "^7.12.1",
    "@babel/plugin-proposal-logical-assignment-operators": "^7.12.1",
    "@babel/plugin-proposal-nullish-coalescing-operator": "^7.12.1",
    "@babel/plugin-proposal-optional-chaining": "^7.12.7",
    "@babel/plugin-proposal-pipeline-operator": "^7.12.1",
    "@babel/plugin-proposal-throw-expressions": "^7.12.1",
    "@babel/plugin-syntax-dynamic-import": "^7.8.3",
    "@babel/plugin-syntax-import-meta": "^7.10.4",
    "@babel/plugin-transform-react-constant-elements": "^7.12.1",
    "@babel/plugin-transform-react-inline-elements": "^7.12.1",
    "@babel/plugin-transform-runtime": "^7.12.1",
    "@babel/preset-env": "^7.12.7",
    "@babel/preset-react": "^7.12.7",
    "@babel/preset-typescript": "^7.12.7",
    "@babel/register": "^7.12.1",
    "@electron/notarize": "^2.5.0",
    "@electron/rebuild": "^3.7.0",
    "@eslint/js": "^9.39.5 || ^10.0.0",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.4.3",
    "@teamsupercell/typings-for-css-modules-loader": "^2.4.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^5.11.6",
    "@testing-library/react": "^16.0.0",
    "@types/history": "4.7.6",
    "@types/jest": "^26.0.15",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/react-router-dom": "^5.1.6",
    "@types/webpack-env": "^1.15.2",
    "@typescript-eslint/eslint-plugin": "^8.24.0",
    "@typescript-eslint/parser": "^8.24.0",
    "autoprefixer": "^10.4.20",
    "babel-jest": "^26.1.0",
    "babel-loader": "^8.2.2",
    "babel-plugin-dev-expression": "^0.2.2",
    "babel-plugin-transform-react-remove-prop-types": "^0.4.24",
    "chalk": "^4.1.0",
    "concurrently": "^5.3.0",
    "core-js": "^3.6.5",
    "cross-env": "^7.0.2",
    "css-loader": "^5.0.1",
    "css-minimizer-webpack-plugin": "^1.1.5",
    "detect-port": "^1.3.0",
    "electron": "44.11.5",
    "electron-builder": "^22.10.5",
    "electron-devtools-installer": "^3.1.1",
    "eslint": "^9.39.5 || ^10.0.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-jest": "^28.11.0",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.1.0",
    "file-loader": "^6.0.0",
    "globals": "^15.14.0",
    "husky": "^4.2.5",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^26.1.0",
    "lint-staged": "^10.2.11",
    "mini-css-extract-plugin": "^1.3.1",
    "opencollective-postinstall": "^2.0.3",
    "postcss": "^8.4.49",
    "prettier": "^2.0.5",
    "react-refresh": "^0.9.0",
    "rimraf": "^3.0.0",
    "tailwindcss": "^3.4.17",
    "terser-webpack-plugin": "^5.0.3",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.24.0",
    "url-loader": "^4.1.0",
    "webpack": "^5.5.1",
    "webpack-bundle-analyzer": "^4.1.0",
    "webpack-cli": "^4.2.0",
    "webpack-dev-server": "^3.11.0",
    "webpack-merge": "^5.4.0",
    "yarn-deduplicate": "^3.1.0"
  },
  "dependencies": {
    "auto-launch": "^5.0.5",
    "clsx": "^2.1.1",
    "electron-log": "^4.2.4",
    "electron-updater": "^4.3.4",
    "history": "^5.0.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "^5.2.0",
    "regenerator-runtime": "^0.13.5",
    "source-map-support": "^0.5.19",
    "tailwind-merge": "^2.6.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "browserslist": [],
  "prettier": {
    "overrides": [
      {
        "files": [
          ".prettierrc",
          ".babelrc",
          ".eslintrc"
        ],
        "options": {
          "parser": "json"
        }
      }
    ],
    "singleQuote": true
  },
  "renovate": {
    "extends": [
      "bliss"
    ],
    "baseBranches": [
      "next"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  }
}
